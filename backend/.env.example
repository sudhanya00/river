# Copy to backend/.env (gitignored). Every RIVER_* setting in app/config.py can be set here.
RIVER_DATABASE_URL=postgresql+psycopg://river:river@localhost:54329/river

# Local development only: fake X-Dev-User sign-in, the dev clock and other /api/dev routes.
RIVER_DEV_MODE=true

# Supabase Auth. With the project's signing keys (default for new projects) only the URL is needed:
# tokens are checked against {URL}/auth/v1/.well-known/jwks.json.
RIVER_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only for projects still on the legacy HS256 JWT secret (Project Settings -> JWT Keys).
RIVER_SUPABASE_JWT_SECRET=

# Timing (days). No message returns before the cooling period, whatever the ranges say.
# RIVER_COOLING_DAYS=30
# RIVER_RETURN_RANGES={"near": [30, 90], "any": [30, 1095], "far": [730, 1825]}
# RIVER_FREE_CATCHES_PER_DAY=5
# RIVER_DEFAULT_TZ=Asia/Kolkata
